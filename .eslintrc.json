{
  "env": {
    "es2021": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "ignorePatterns": [
    ".homeybuild/",
    "node_modules/"
  ],
  "parserOptions": {
    "ecmaVersion": 2022
  },
  "rules": {
    "no-constant-condition": [
      "error",
      {
        "checkLoops": false
      }
    ],
    "no-empty": [
      "error",
      {
        "allowEmptyCatch": true
      }
    ]
  }
}
